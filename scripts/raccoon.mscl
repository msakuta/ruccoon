
fn go_to_hole() -> i64 {
    print("Finding path to hole");

    for i in 0..100 {
        if is_at_hole() {
            return 0;
        }

        print("Enemies: ", len(get_enemies()));

        var enemy = find_enemy();
        if 1 < len(enemy) {
            var this_pos = get_pos();
            shoot(enemy[0] - this_pos[0], enemy[1] - this_pos[1]);

            print("enemy: ", enemy[0], enemy[1]);
        } else {
            print("Enemy not found");
        }

        if find_path_to_hole() {
            yield_(get_next_move());
        } else {
            return 0;
        }
    }

    0
}

fn go_to_corn() -> i64 {
    print("Finding path to corn");

    for i in 0..100 {
        if get_satiety() > 0.6 {
            return 0;
        };
        if find_path_to_corn() {
            yield_(get_next_move());
        } else {
            return 0;
        }
    }

    0
}

var enemy_found: i32 = 0;
var enemy_pos: [i32] = [];

for i in 0..10000 {

    if get_satiety() < 0.6 {
        go_to_corn();
        yield_(-1);
    };

    go_to_hole();
    yield_(-1);
}
